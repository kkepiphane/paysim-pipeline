DATA_ROOT=/opt/airflow/data
SOURCE_FILE=PS_20174392719_1491204439457_log.csv
SPARK_DRIVER_MEMORY=4g

# Metadata DB Airflow (docker compose)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Compte admin de l'UI Airflow — change ces valeurs si le port 8080 est exposé
# au-delà de ta machine locale.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Warehouse Postgres (docker compose) — sert le dashboard Streamlit, séparé de
# la metadata DB Airflow ci-dessus. WAREHOUSE_HOST/PORT sont vus depuis l'hôte
# (le dashboard tourne en local, pas dans Docker) : make load-warehouse / make dashboard.
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# Kafka (simulation d'ingestion temps réel) — producer/consumer tournent en
# local (make produce / make consume), pas dans Docker.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=paysim-transactions
